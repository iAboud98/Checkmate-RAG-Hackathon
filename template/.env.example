# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=

# Where the documents are (organizers' docs go in data/raw; data/examples = fictional test docs)
DOCS_DIR=data/raw

# Models: check what your key can use with  python scripts/list_models.py
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_REWRITE_MODEL=gpt-5-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_REASONING_EFFORT=low

# Optional, for the analytics cost estimate (USD per 1M tokens, from OpenAI's pricing page)
PRICE_INPUT_PER_1M=
PRICE_OUTPUT_PER_1M=

# Ingestion
OCR_ENGINE=tesseract
OCR_LANG=ara+eng
MAX_SECTION_CHARS=2500

# Retrieval (calibrate the threshold with: python eval/run_eval.py --calibrate)
TOP_K=4
REFUSAL_THRESHOLD=0.40

# Login: users as name:role:hash (make entries with: python scripts/hash_password.py)
AUTH_ENABLED=true
AUTH_USERS=
