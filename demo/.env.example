# Copy this file to .env and fill in your key. Never commit .env.
OPENAI_API_KEY=

# Models (change to any model your OpenAI account has access to)
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_REWRITE_MODEL=gpt-5-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# Only used by reasoning models (gpt-5*, o*): low = faster answers
OPENAI_REASONING_EFFORT=low

# Knobs to experiment with (see README "Experiments to try")
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=4
REFUSAL_THRESHOLD=0.30

# OCR language for scanned pages: "ara+eng" keeps Latin codes, "ara" reads Arabic words better
OCR_LANG=ara+eng
